# Ralph Local model defaults
#
# Human-editable defaults for the local Ralph scripts. Keep this file
# shell-sourcable: KEY="value" lines only, no command execution needed.
#
# Runtime env vars still win:
#   RALPH_CODEX_MODEL="..." RALPH_CODEX_REASONING_EFFORT="..." \
#   RALPH_CODEX_BYPASS_SANDBOX="0|1" \
#     .agents/skills/ralph-local/ralph-local.sh <prd-ref>

RALPH_DEFAULT_CODEX_MODEL="gpt-5.5"
RALPH_DEFAULT_CODEX_REASONING_EFFORT="low"
# Hosts that cannot run Codex's bubblewrap sandbox can set this to "1".
# Keep bypass project-local and explicit instead of changing global Codex config.
RALPH_DEFAULT_CODEX_BYPASS_SANDBOX="0"
RALPH_DEFAULT_MAX_REVIEW_ITERATIONS="10"
