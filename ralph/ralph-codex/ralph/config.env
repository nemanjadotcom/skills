# Ralph Codex runtime defaults.
#
# These can still be overridden for one run, for example:
# RALPH_CODEX_MODEL=gpt-5.5 RALPH_CODEX_REASONING_EFFORT=high .agents/skills/ralph/ralph-once.sh 123

RALPH_CODEX_MODEL="${RALPH_CODEX_MODEL:-gpt-5.5}"
RALPH_CODEX_REASONING_EFFORT="${RALPH_CODEX_REASONING_EFFORT:-low}"
